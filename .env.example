# Supabase project in ap-south-1 (Mumbai). Never commit real secrets.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# PowerSync Cloud instance region `in` (ap-south-1)
EXPO_PUBLIC_POWERSYNC_URL=https://YOUR_INSTANCE.powersync.journeyapps.com

# MSG91 (Send SMS hook). Required before real-patient OTP.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
SEND_SMS_HOOK_SECRET=

# Expo push (V2)
EXPO_ACCESS_TOKEN=

# Local demo: seed fictional patients, skip remote sync
EXPO_PUBLIC_DEMO=1
CLIENT_VERSION=1.0.0
