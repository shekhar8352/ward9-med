{
  "expo": {
    "name": "Ward Checklist",
    "slug": "ward9-checklist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ward9",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.ward9.checklist",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of wound and investigation files for the ward checklist.",
        "NSPhotoLibraryUsageDescription": "Attach an existing photo of a file or X-ray.",
        "NSFaceIDUsageDescription": "Unlock Ward Checklist with Face ID."
      }
    },
    "android": {
      "package": "in.ward9.checklist",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D3E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach an existing photo of a file or X-ray.",
          "cameraPermission": "Take photos of wound and investigation files for the ward checklist."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F3D3E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-after-eas-init"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/replace-after-eas-init"
    }
  }
}
